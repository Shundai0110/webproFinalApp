{
  "name": "keio-book-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "dev": "npm --prefix backend run dev:ephemeral",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ephemeral": "npm --prefix backend run dev:ephemeral",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "start": "npm --prefix backend start",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:browser": "npm --prefix backend run test:browser"
  }
}
